{
  "name": "calm-twitter",
  "private": true,
  "version": "2.1.0",
  "description": "This extension hides trending information from twitter timelines to make your mind calm.",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "standard",
    "build:old": "gulp pack --production --vendor=chrome",
    "dev:old": "gulp --watch --vendor=chrome"
  },
  "standard": {
    "globals": [
      "chrome"
    ]
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.1.0",
    "@types/chrome": "^0.x.x",
    "sass": "^1.49.9",
    "standard": "16.x.x",
    "tslint": "^6.x.x",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "core-js": "^3.45.0"
  }
}
